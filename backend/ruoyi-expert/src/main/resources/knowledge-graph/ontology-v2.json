      "cardinality": "N:1",
      "evidenceRequired": true
    },
    "WORKS_IN_INDUSTRY": {
      "from": ["Expert"],
      "to": ["Industry"],
      "cardinality": "N:N",
      "evidenceRequired": true
    },
    "SERVES_REGION": {
