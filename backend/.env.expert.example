# Application
SERVER_PORT=8080

# Security
TOKEN_SECRET=abcdefghijklmnopqrstuvwxyz
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=123456

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=science_expert
DB_USERNAME=root
DB_PASSWORD=
DB_USE_SSL=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me-to-a-strong-password

# DeepSeek remote Agent
EXPERT_AGENT_MODE=remote
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# MinIO object storage
# 本地开发时这组凭据同时作为 MinIO 容器的 root 凭据。
EXPERT_STORAGE_TYPE=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=science-expert
MINIO_REGION=us-east-1
MINIO_DATA_DIR=../miniodata

# Alibaba Cloud OCR RecognizeAllText
EXPERT_OCR_ENABLED=true
EXPERT_OCR_PROVIDER=aliyun
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIYUN_OCR_REGION=cn-hangzhou
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_TYPE=Advanced
ALIYUN_OCR_MAX_PAGES=30

# Neo4j read-model sync
EXPERT_KG_NEO4J_ENABLED=true
EXPERT_KG_NEO4J_DATABASE=neo4j
EXPERT_KG_SYNC_BATCH_SIZE=20

# Neo4j Docker service
NEO4J_IMAGE=neo4j:5.26.0-community
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-strong-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=512m
